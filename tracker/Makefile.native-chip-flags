# Native chip hot paths need speed rather than minimum code size on ARM64.
# Keep IEEE arithmetic: no fast-math or patch/quality simplification.
NATIVE_CHIP_OPT_FLAGS ?=
NATIVE_CHIP_HOT_SOURCES = ../chipnomad_lib/synth/monk_dsp.cpp ../chipnomad_lib/synth/monk_delay_dsp.cpp ../chipnomad_lib/synth/monk_synth_dsp.cpp ../chipnomad_lib/synth/monk_voice.cpp \
  ../chipnomad_lib/beads_insert.cpp ../chipnomad_lib/external/mutable/beads/% \
  ../chipnomad_lib/external/ymfm/% \
  ../chipnomad_lib/external/msfa/% ../chipnomad_lib/external/gb_apu/% \
  ../chipnomad_lib/external/emu76489/% \
  ../chipnomad_lib/synth/opll_voice.cpp ../chipnomad_lib/synth/opl_voice.cpp \
  ../chipnomad_lib/synth/four_op_voice.cpp ../chipnomad_lib/synth/dx7_voice.cpp \
  ../chipnomad_lib/synth/simple_chip_voice.cpp ../chipnomad_lib/synth/sid_voice.cpp
native_chip_opt_flags = $(if $(filter $(NATIVE_CHIP_HOT_SOURCES),$(1)),$(NATIVE_CHIP_OPT_FLAGS))

# Common makefile settings and source files

# Version (parsed from source)
VERSION = $(shell grep 'appVersion.*=' src/version.cpp | cut -d'"' -f2)

# Common source directories
PLAITS_LIBS = ../chipnomad_lib/external/mutable/plaits \
	../chipnomad_lib/external/mutable/plaits/dsp \
	../chipnomad_lib/external/mutable/plaits/dsp/chords \
	../chipnomad_lib/external/mutable/plaits/dsp/engine \
	../chipnomad_lib/external/mutable/plaits/dsp/engine2 \
	../chipnomad_lib/external/mutable/plaits/dsp/fm \
	../chipnomad_lib/external/mutable/plaits/dsp/physical_modelling \
	../chipnomad_lib/external/mutable/plaits/dsp/speech \
	../chipnomad_lib/external/mutable/stmlib/dsp
PLAITS_ALT_LIBS = ../chipnomad_lib/external/mutable/plaits_alt \
	../chipnomad_lib/external/mutable/plaits_alt/dsp \
	../chipnomad_lib/external/mutable/plaits_alt/dsp/chords \
	../chipnomad_lib/external/mutable/plaits_alt/dsp/engine \
	../chipnomad_lib/external/mutable/plaits_alt/dsp/engine2 \
	../chipnomad_lib/external/mutable/plaits_alt/dsp/fm \
	../chipnomad_lib/external/mutable/plaits_alt/dsp/physical_modelling \
	../chipnomad_lib/external/mutable/plaits_alt/dsp/speech
COMMON_LIBS = src ../chipnomad_lib ../chipnomad_lib/chips ../chipnomad_lib/synth ../chipnomad_lib/external/ayumi ../chipnomad_lib/external/mutable/braids ../chipnomad_lib/external/mutable/stmlib/utils $(PLAITS_LIBS) $(PLAITS_ALT_LIBS) ../chipnomad_lib/export src/corelib src/import src/screens platforms/shared

# Base build directory
BUILD_BASE = build

# Platform-specific build directory (to be set by platform makefiles)
BUILD = $(BUILD_BASE)/$(PLATFORM)

# Common includes and sources
# Do not expose Plaits' physical_modelling directory directly: its string.h
# would shadow the C standard header. Plaits includes it from the mutable root.
INCLUDE_LIBS = $(filter-out ../chipnomad_lib/external/mutable/plaits/dsp/physical_modelling ../chipnomad_lib/external/mutable/plaits_alt/dsp/physical_modelling,$(LIBS))
INCLUDES = $(addprefix -I, $(INCLUDE_LIBS)) -I../chipnomad_lib -I../chipnomad_lib/external/mutable
C_SOURCES = $(foreach dir, $(LIBS), $(wildcard $(dir)/*.c))
# The Plaits-Alt checkout also contains the STM32 module application. Tracker
# needs its DSP/resources only; compiling its firmware UI would pull hardware
# dependencies into every desktop target.
PLAITS_ALT_FIRMWARE_SOURCES = ../chipnomad_lib/external/mutable/plaits_alt/plaits.cc \
	../chipnomad_lib/external/mutable/plaits_alt/settings.cc \
	../chipnomad_lib/external/mutable/plaits_alt/ui.cc \
	../chipnomad_lib/external/mutable/plaits_alt/user_data_receiver.cc
CPP_SOURCES = $(filter-out $(PLAITS_ALT_FIRMWARE_SOURCES),$(foreach dir, $(LIBS), $(wildcard $(dir)/*.cpp)) $(foreach dir, $(LIBS), $(wildcard $(dir)/*.cc)))
SOURCES = $(C_SOURCES) $(CPP_SOURCES)
SRC_FILES = $(foreach dir, $(LIBS), $(wildcard $(dir)/*.c)) $(foreach dir, $(LIBS), $(wildcard $(dir)/*.cpp)) $(foreach dir, $(LIBS), $(wildcard $(dir)/*.h))

# Always use C++ compiler for better compatibility with future C++ modules
# C files are compiled as C++ (C is mostly compatible with C++)
COMPILER = $(CXX)
STD_FLAG = -std=c++17
CPP_LIBS =

# Common compiler flags
COMMON_CFLAGS = $(STD_FLAG) -Wall -g -Os -flto -DTEST

# Common data directories from packaging/common (auto-discovered)
COMMON_DATA_DIRS = $(patsubst packaging/common/%/,%,$(wildcard packaging/common/*/))

# Build target helper
define build_target
	mkdir -p $(BUILD)
	$(COMPILER) $(CFLAGS) $(CPP_LIBS) $(XTRA_LIBS) $(OUTPUT)
	chmod +x $(BUILD)/choochootracker$(OUTPUT_EXT)
endef

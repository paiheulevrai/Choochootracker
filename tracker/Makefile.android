# Android makefile using NDK

# Android platform identifier
PLATFORM = android

include Makefile.common

# Android-specific settings - use common libs + sdl2 platform with mobile features
LIBS = $(COMMON_LIBS) platforms/sdl2
ANDROID_SOURCES = platforms/android/corelib_assets.cpp
OUTPUT_EXT =

# NDK settings
NDK_PATH ?= $(ANDROID_NDK_ROOT)
HOST_TAG ?= $(if $(findstring Windows_NT,$(OS)),windows-x86_64,$(if $(findstring Darwin,$(shell uname)),darwin-x86_64,linux-x86_64))
TOOLCHAIN = $(NDK_PATH)/toolchains/llvm/prebuilt/$(HOST_TAG)
API_LEVEL = 26

# SDL2 paths
SDL2_INCLUDE ?= ../.tmp/SDL2-2.32.10
SDL2_LIB = platforms/android/app/src/main/jniLibs

# Target architectures
ARCH ?= arm64-v8a
ifeq ($(ARCH),arm64-v8a)
TARGET = aarch64-linux-android$(API_LEVEL)
BUILD_DIR = $(BUILD_BASE)/android-arm64
else ifeq ($(ARCH),armeabi-v7a)
TARGET = armv7a-linux-androideabi$(API_LEVEL)
BUILD_DIR = $(BUILD_BASE)/android-arm32
endif

# Compiler setup
CC = $(TOOLCHAIN)/bin/$(TARGET)-clang++
AR = $(TOOLCHAIN)/bin/llvm-ar
STRIP = $(TOOLCHAIN)/bin/llvm-strip

# Android-specific flags
XTRA_CFLAGS = -DANDROID_BUILD -DMOBILE_BUILD -DMOBILE_LIFECYCLE -DTOUCH_INPUT -DGAMEPAD_SUPPORT -fPIC -I$(SDL2_INCLUDE)
XTRA_LIBS = -static-libstdc++ -L$(SDL2_LIB)/$(ARCH) -lSDL2 -lm -llog -landroid

# Android's Windows linker can fail without diagnostics when LTO combines the
# complete tracker in one process. Keep release optimisation, skip only LTO.
ANDROID_CFLAGS = $(filter-out -flto,$(COMMON_CFLAGS))
CFLAGS = $(ANDROID_CFLAGS) $(INCLUDES) $(SOURCES) $(ANDROID_SOURCES) $(XTRA_CFLAGS)
OUTPUT = -o $(BUILD_DIR)/libchipnomad.so

.PHONY: android android-lib android-apk android-bundle
android: android-lib

android-lib:
	mkdir -p $(BUILD_DIR)
	$(CC) -shared $(CFLAGS) $(XTRA_LIBS) $(OUTPUT)
	$(STRIP) $(BUILD_DIR)/libchipnomad.so

.PHONY: android-apk
android-apk: android-lib
	cd platforms/android && ./gradlew assembleRelease

android-bundle: android-lib
	cd platforms/android && ./gradlew bundleRelease

.PHONY: android-deploy
android-deploy: android-apk android-bundle
	@echo "Creating Android deployment package..."
	@mkdir -p ../../releases
	@rm -rf /tmp/chipnomad-android-package
	@mkdir -p /tmp/chipnomad-android-package
	@cp platforms/android/app/build/outputs/apk/release/app-release.apk /tmp/chipnomad-android-package/ChooChooTracker-universal-release.apk
	@cp platforms/android/app/build/outputs/bundle/release/app-release.aab /tmp/chipnomad-android-package/ChooChooTracker-release.aab
	@cd /tmp/chipnomad-android-package && zip -r ChooChooTracker-$$(date +%Y-%m-%d)-Android.zip .
	@mv /tmp/chipnomad-android-package/ChooChooTracker-*-Android.zip ../../releases/
	@rm -rf /tmp/chipnomad-android-package
	@echo "Android package created in ../../releases/"

# Windows makefile

# Windows platform identifier
PLATFORM = windows

include Makefile.common

# Windows-specific settings
LIBS = $(COMMON_LIBS) platforms/sdl2 ../chipnomad_lib/external/rtmidi
OUTPUT_EXT = .exe

# Native Windows development uses the SDL2 package installed by MSYS2.
# SDL_main is already provided by platforms/shared/main.cpp.
SDL_CFLAGS := $(filter-out -Dmain=SDL_main,$(shell sdl2-config --cflags))
SDL_LIBS := $(shell sdl2-config --libs)

XTRA_CFLAGS = $(SDL_CFLAGS) -DDESKTOP_BUILD -DGAMEPAD_SUPPORT -D__USE_MINGW_ANSI_STDIO=1 -D__WINDOWS_MM__ \
	-DLINK_PLATFORM_WINDOWS=1 -DINCL_EXTRA_HTON_FUNCTIONS=1 -D_WIN32_WINNT=0x0601 -DASIO_STANDALONE=1 -DASIO_NO_TYPEID=1 -DASIO_VERSION_NAMESPACE=link_asio_1_38_2 -Wno-multichar
XTRA_LIBS = $(SDL_LIBS) -lws2_32 -liphlpapi -lkernel32 -static-libgcc -static-libstdc++ -lwinmm
# The pinned SID core uses the CRT's optional math constants in C++17.
WINDOWS_CFLAGS = $(filter-out -flto,$(COMMON_CFLAGS)) -D_USE_MATH_DEFINES
WINDRES ?= $(shell command -v x86_64-w64-mingw32-windres 2>/dev/null || command -v windres)
WINDOWS_ICON = $(BUILD)/choochootracker-icon.o
CFLAGS = $(WINDOWS_CFLAGS) $(INCLUDES) $(XTRA_CFLAGS)
TARGET = $(BUILD)/choochootracker$(OUTPUT_EXT)
OUTPUT = -o $(BUILD)/choochootracker$(OUTPUT_EXT)

object_for = $(BUILD)/obj/$(subst ../,up/,$(basename $(1))).o
OBJECTS := $(foreach source,$(SOURCES),$(call object_for,$(source)))
HEADERS := $(sort $(shell find $(LIBS) -name '*.h' -print 2>/dev/null))
HEADER_STAMP = $(BUILD)/obj/.headers

$(HEADER_STAMP): $(HEADERS)
	@mkdir -p $(dir $@)
	@touch $@

define compile_source
$(call object_for,$(1)): $(1) $(HEADER_STAMP) Makefile.windows Makefile.common
	@mkdir -p $$(dir $$@)
	@$(CXX) $(CFLAGS) -c $$< -o $$@
endef

$(foreach source,$(SOURCES),$(eval $(call compile_source,$(source))))

$(WINDOWS_ICON): packaging/windows/choochootracker.rc packaging/windows/choochootracker.ico
	@mkdir -p $(dir $@)
	$(WINDRES) $< -O coff -o $@

.PHONY: windows choochooplayer

# Build the visualizer through its own source list, using the same MSYS2
# toolchain and runtime conventions as the tracker.
choochooplayer:
	$(MAKE) -C ../choochooplayer windows

windows: $(TARGET)
	cp "$$(dirname "$$(command -v sdl2-config)")/SDL2.dll" $(BUILD)/
	cp "$$(dirname "$$(command -v sdl2-config)")/libwinpthread-1.dll" $(BUILD)/
	cp -r packaging/common/* $(BUILD)/

$(TARGET): $(OBJECTS) $(WINDOWS_ICON)
	mkdir -p $(BUILD)
	$(CXX) $(WINDOWS_CFLAGS) $(OBJECTS) $(WINDOWS_ICON) $(XTRA_LIBS) $(OUTPUT)

# Docker-based Windows build (internal target)
.PHONY: .windows-docker
.windows-docker:
	mkdir -p $(BUILD)
	$(CC) -std=c++17 -O2 -D_USE_MATH_DEFINES \
		-I/opt/SDL2/x86_64-w64-mingw32/include \
		$(INCLUDES) $(SOURCES) \
		-L/opt/SDL2/x86_64-w64-mingw32/lib \
		-lmingw32 -lSDL2main -lSDL2 -lwinmm \
		-static-libgcc -static-libstdc++ \
		-DDESKTOP_BUILD -D__USE_MINGW_ANSI_STDIO=1 -D__WINDOWS_MM__ \
		-o $(BUILD)/choochootracker.exe
	cp /opt/SDL2/x86_64-w64-mingw32/bin/SDL2.dll $(BUILD)/

# Windows deployment using Docker
.PHONY: windows-deploy
windows-deploy:
	@echo "Creating Windows deployment package..."
	@./check-docker.sh || exit 1
	@echo "Building Windows cross-compilation Docker image..."
	@docker build -f Dockerfile.windows -t chipnomad-windows-builder . || (echo "Error: Failed to build Docker image" && exit 1)
	@docker run --rm -v "$$(pwd)/..:/workspace" -w /workspace/tracker chipnomad-windows-builder make -f Makefile.windows .windows-docker CC=x86_64-w64-mingw32-g++
	@mkdir -p ../../releases
	@cp -r packaging/common/* $(BUILD)/
	@cp packaging/windows/README.txt $(BUILD)/
	@cd $(BUILD) && zip -r ChooChooTracker-$$(date +%Y-%m-%d)-$(VERSION)-Windows.zip choochootracker.exe SDL2.dll $(COMMON_DATA_DIRS) README.txt
	@mv $(BUILD)/ChooChooTracker-*-Windows.zip ../../releases/
	@echo "Windows package created in ../../releases/"

# Native ARM64 PortMaster build from Ubuntu/WSL2.

PLATFORM = portmaster
include Makefile.common
NATIVE_CHIP_OPT_FLAGS ?= -O3
include Makefile.native-chip-flags

LIBS = $(COMMON_LIBS) platforms/sdl2 ../chipnomad_lib/external/rtmidi
CXX = aarch64-linux-gnu-g++
STRIP = aarch64-linux-gnu-strip
PKG_CONFIG ?= pkg-config
PKG_CONFIG_SYSROOT_DIR ?=
ifeq ($(strip $(PKG_CONFIG_LIBDIR)),)
PKG_CONFIG_LIBDIR = $(if $(PKG_CONFIG_SYSROOT_DIR),$(PKG_CONFIG_SYSROOT_DIR)/usr/lib/aarch64-linux-gnu/pkgconfig:$(PKG_CONFIG_SYSROOT_DIR)/usr/share/pkgconfig,/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig)
endif

ifneq ($(strip $(PKG_CONFIG_SYSROOT_DIR)),)
SDL_CFLAGS := -I$(PKG_CONFIG_SYSROOT_DIR)/usr/include -I$(PKG_CONFIG_SYSROOT_DIR)/usr/include/aarch64-linux-gnu
SDL_LIBS := -L$(PKG_CONFIG_SYSROOT_DIR)/usr/lib/aarch64-linux-gnu -lSDL2 -Wl,--allow-shlib-undefined
else
SDL_CFLAGS := $(shell PKG_CONFIG_LIBDIR=$(PKG_CONFIG_LIBDIR) $(PKG_CONFIG) --cflags sdl2)
SDL_LIBS := $(shell PKG_CONFIG_LIBDIR=$(PKG_CONFIG_LIBDIR) $(PKG_CONFIG) --libs sdl2)
endif
# PortMaster consoles are CPU-bound by the SDL UI too.  Keep the debug
# information, but optimize the entire application for execution speed rather
# than binary size; the DSP sources already use the same policy.
PORTMASTER_CFLAGS = $(filter-out -Os,$(COMMON_CFLAGS)) -O3
CFLAGS = $(PORTMASTER_CFLAGS) $(INCLUDES) $(SDL_CFLAGS) -DPORTMASTER_BUILD -D__LINUX_ALSASEQ__ -DGAMEPAD_SUPPORT -DTOUCH_INPUT \
	-DLINK_PLATFORM_LINUX=1 -DASIO_STANDALONE=1 -DASIO_NO_TYPEID=1 -DASIO_VERSION_NAMESPACE=link_asio_1_38_2 -Wno-multichar
TARGET = $(BUILD)/choochootracker.aarch64
OUTPUT = -o $(TARGET)

object_for = $(BUILD)/obj/$(subst ../,up/,$(basename $(1))).o
OBJECTS := $(foreach source,$(SOURCES),$(call object_for,$(source)))
DEPS := $(OBJECTS:.o=.d)

define compile_source
$(call object_for,$(1)): $(1) Makefile.portmaster Makefile.common Makefile.native-chip-flags
	@mkdir -p $$(dir $$@)
	@$(CXX) $(CFLAGS) $(call native_chip_opt_flags,$(1)) -MMD -MP -c $$< -o $$@
endef

$(foreach source,$(SOURCES),$(eval $(call compile_source,$(source))))
-include $(DEPS)

PACKAGE_ROOT = $(BUILD)/package
PORT_DIR = $(PACKAGE_ROOT)/choochootracker
RELEASE = ../releases/choochootracker.zip

.PHONY: PortMaster
PortMaster: $(BUILD)/choochootracker.aarch64

$(BUILD)/choochootracker.aarch64: $(OBJECTS)
	mkdir -p $(BUILD)
	$(CXX) $(PORTMASTER_CFLAGS) $(OBJECTS) $(SDL_LIBS)  -lasound -pthread -lm -latomic $(OUTPUT)
	$(STRIP) $(BUILD)/choochootracker.aarch64

.PHONY: PortMaster-deploy
PortMaster-deploy: PortMaster
	rm -rf $(PACKAGE_ROOT)
	mkdir -p $(PORT_DIR)/licenses ../releases
	cp $(BUILD)/choochootracker.aarch64 $(PORT_DIR)/
	cp packaging/portmaster/choochootracker.gptk $(PORT_DIR)/
	cp -r packaging/common/. $(PORT_DIR)/
	cp ../docs/USER_MANUAL.md $(PORT_DIR)/
	cp ../LICENSE $(PORT_DIR)/licenses/LICENSE.choochootracker.md
	cp ../chipnomad_lib/external/insert_fx/LICENSE-JM-Formant $(PORT_DIR)/licenses/
	cp packaging/portmaster/license/* $(PORT_DIR)/licenses/
	cp packaging/portmaster/ChooChooTracker.sh $(PACKAGE_ROOT)/
	cp packaging/portmaster/port.json packaging/portmaster/README.md packaging/portmaster/gameinfo.xml packaging/portmaster/cover.png packaging/portmaster/screenshot.png $(PORT_DIR)/
	chmod +x $(PACKAGE_ROOT)/ChooChooTracker.sh $(PORT_DIR)/choochootracker.aarch64
	sed -i "s/BUILD_DATE_PLACEHOLDER/$$(date +%Y%m%dT%H%M%S)/" $(PORT_DIR)/gameinfo.xml
	rm -f $(BUILD)/choochootracker.zip $(RELEASE)
	cd $(PACKAGE_ROOT) && zip -qr ../choochootracker.zip .
	cp $(BUILD)/choochootracker.zip $(RELEASE)
	@echo "PortMaster package created: $(RELEASE)"

# macOS makefile

# macOS platform identifier
PLATFORM = macos

include Makefile.common

# Set compilers
CC = clang
CXX = clang++

# macOS-specific settings
LIBS = $(COMMON_LIBS) platforms/sdl2 ../chipnomad_lib/external/rtmidi
OUTPUT_EXT =

# SDL2 Framework path
SDL2_FRAMEWORK = platforms/macos/Frameworks/SDL2.framework

# macOS-specific flags (Universal Binary: ARM64 + x86_64)
# Using SDL2.framework for better portability
XTRA_CFLAGS = -arch arm64 -arch x86_64 -mmacosx-version-min=11.0 -F$(SDL2_FRAMEWORK)/.. -DDESKTOP_BUILD -DMACOS_BUILD -DGAMEPAD_SUPPORT -D__MACOSX_CORE__ \
	-DLINK_PLATFORM_MACOSX=1 -DASIO_STANDALONE=1 -DASIO_NO_TYPEID=1 -DASIO_VERSION_NAMESPACE=link_asio_1_38_2 -Wno-multichar
XTRA_LIBS = -arch arm64 -arch x86_64 -mmacosx-version-min=11.0 -F$(SDL2_FRAMEWORK)/.. -framework SDL2 -framework Cocoa -framework CoreMIDI -framework CoreAudio -framework CoreFoundation -lm -rpath @executable_path/../Frameworks
CFLAGS = $(COMMON_CFLAGS) $(INCLUDES) $(SOURCES) $(XTRA_CFLAGS)
OUTPUT = -o $(BUILD)/choochootracker$(OUTPUT_EXT)

.PHONY: macOS
macOS:
	@if [ ! -d "$(SDL2_FRAMEWORK)" ]; then \
		echo "SDL2.framework not found!"; \
		echo ""; \
		echo "Please run: bash platforms/macos/check-sdl2.sh --download"; \
		echo "Or see: platforms/macos/Frameworks/README.md"; \
		exit 1; \
	fi
	$(call build_target)

# macOS deployment
APP := ChooChooTracker
APP_BUNDLE := $(APP).app
VERSION_NUMERIC = $(firstword $(subst -, ,$(VERSION)))
MACOS_ARCHIVE = $(APP)-v$(VERSION)-macOS-universal.zip

.PHONY: macOS-app-bundle
macOS-app-bundle: macOS
	@echo "Creating macOS .app bundle..."
	@rm -rf $(BUILD)/$(APP_BUNDLE)
	@mkdir -p $(BUILD)/$(APP_BUNDLE)/Contents/MacOS $(BUILD)/$(APP_BUNDLE)/Contents/Resources $(BUILD)/$(APP_BUNDLE)/Contents/Frameworks
	@cp $(BUILD)/choochootracker $(BUILD)/$(APP_BUNDLE)/Contents/MacOS/
	@strip -S $(BUILD)/$(APP_BUNDLE)/Contents/MacOS/choochootracker
	@cp -R packaging/common $(BUILD)/$(APP_BUNDLE)/Contents/Resources/common
	@cp ../docs/USER_MANUAL.md $(BUILD)/$(APP_BUNDLE)/Contents/Resources/
	@mkdir -p $(BUILD)/$(APP_BUNDLE)/Contents/Resources/licenses
	@cp ../LICENSE packaging/portmaster/license/* $(BUILD)/$(APP_BUNDLE)/Contents/Resources/licenses/
	@iconutil -c icns packaging/macos/ChooChooTracker.iconset -o $(BUILD)/$(APP_BUNDLE)/Contents/Resources/ChooChooTracker.icns
	@echo "Copying SDL2.framework to bundle..."
	@cp -R $(SDL2_FRAMEWORK) $(BUILD)/$(APP_BUNDLE)/Contents/Frameworks/
	@cp packaging/macos/Info.plist $(BUILD)/$(APP_BUNDLE)/Contents/
	@plutil -replace CFBundleVersion -string "$(VERSION_NUMERIC)" $(BUILD)/$(APP_BUNDLE)/Contents/Info.plist
	@plutil -replace CFBundleShortVersionString -string "$(VERSION_NUMERIC)" $(BUILD)/$(APP_BUNDLE)/Contents/Info.plist
	@codesign --force --sign - --timestamp=none $(BUILD)/$(APP_BUNDLE)/Contents/Frameworks/SDL2.framework
	@codesign --force --sign - --timestamp=none $(BUILD)/$(APP_BUNDLE)
	@codesign --verify --deep --strict $(BUILD)/$(APP_BUNDLE)
	@echo ".app bundle created at $(BUILD)/$(APP_BUNDLE)"

.PHONY: macOS-deploy
macOS-deploy: macOS-app-bundle
	@echo "Creating macOS deployment package..."
	@mkdir -p ../releases
	@cp packaging/macos/README.txt $(BUILD)/README.txt
	@rm -f ../releases/$(MACOS_ARCHIVE)
	@cd $(BUILD) && zip -qry ../../../releases/$(MACOS_ARCHIVE) $(APP_BUNDLE) README.txt
	@echo "macOS package created: ../releases/$(MACOS_ARCHIVE)"
